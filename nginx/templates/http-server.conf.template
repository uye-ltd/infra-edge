# ---- HTTP server -------------------------------------------------------------
# Default server on port 80 for ALL hosts (platform and application sites).
# DNS-01 handles certificate issuance; HTTP only redirects to HTTPS.
server {
    listen       80 default_server;
    listen  [::]:80 default_server;
    server_name  _;

    # Health probe and stub_status are available over HTTP so load balancers,
    # the container HEALTHCHECK and nginx-exporter work without TLS.
    include /etc/nginx/snippets/health.conf;

    # Redirect everything else to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}
