# ---- HTTPS default server ----------------------------------------------------
# Catches TLS requests whose Host matches no site in templates/sites/.
# Serves only health/status endpoints and closes the connection for anything
# else (444), so unknown hosts never reach an application upstream.
# Application sites live in templates/sites/<app>.conf.template.
server {
    listen       443 ssl default_server;
    listen  [::]:443 ssl default_server;
    http2         on;
    server_name   _;

    ssl_certificate      ${NGINX_SSL_CERT_PATH};
    ssl_certificate_key  ${NGINX_SSL_KEY_PATH};
    ssl_trusted_certificate ${NGINX_SSL_CHAIN_PATH};

    include /etc/nginx/snippets/health.conf;

    location / {
        return 444;
    }
}
